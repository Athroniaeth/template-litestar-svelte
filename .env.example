# Point d'entrée de l'application, lu par la CLI Litestar.
# Requis : l'autodiscovery ne cherche que app.py/application.py à la racine.
LITESTAR_APP=backend.app:app

# Sert le bundle de frontend/public/ au lieu de lancer le dev server Vite.
# Lu par backend/__init__.py. Défaut : true
#VITE_DEV_MODE=false

# Port du dev server Vite. Lu par frontend/vite.config.ts. Défaut : 5173
#VITE_PORT=5173

# Préfixe des URLs d'assets. Lu par PathConfig. Défaut : /static/
#ASSET_URL=/static/

# Uniquement si Vite tourne séparément de Litestar (pnpm dev dans frontend/).
# Lu par frontend/src/generated/routes.ts
#VITE_API_URL=http://localhost:8000
